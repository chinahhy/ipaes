#!/bin/sh
# Rotate the nginx access log before it grows without bound.
# /logs is a bind mount, so the image's default logrotate rules never see it.
set -eu

LOG=/logs/nginx-access.log
MAX_BYTES=${MAX_BYTES:-104857600}

[ -f "$LOG" ] || exit 0
SIZE=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
[ "$SIZE" -gt "$MAX_BYTES" ] || exit 0

mv -f "$LOG" "$LOG.1"
: > "$LOG"
if command -v gzip >/dev/null 2>&1; then
    gzip -f "$LOG.1" 2>/dev/null || true
fi
/usr/sbin/nginx -s reopen 2>/dev/null || true
